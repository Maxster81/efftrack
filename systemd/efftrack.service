# =============================================================================
# Effort Tracking — systemd service unit (TEMPLATE, NON ATTIVATO)
# =============================================================================
# Questo file è un template documentale. NON viene attivato automaticamente.
# I path qui sotto (WorkingDirectory, ExecStart, ReadWritePaths, EnvironmentFile)
# sono pensati per l'installazione STANDARD in /opt/efftrack con file env
# /etc/efftrack.env. Se usi il deploy.sh con --dir o --env-file personalizzati,
# ADATTA questi path di conseguenza (non sovrascriverà mai il tuo .service
# in modalità --update: te lo segnala e lo aggiorni a mano).
#
# Per usarlo in produzione (path standard):
#   1. Copialo in /etc/systemd/system/efftrack.service
#      sudo cp systemd/efftrack.service /etc/systemd/system/efftrack.service
#   2. Crea l'utente dedicato (una tantum):
#      sudo useradd --system --home /opt/efftrack --shell /usr/sbin/nologin efftrack
#   3. Crea la cartella di deploy e dai i permessi (inclusa data/,
#      richiesta da ReadWritePaths PRIMA dell'avvio del servizio):
#      sudo mkdir -p /opt/efftrack/data
#      sudo chown -R efftrack:efftrack /opt/efftrack
#   4. Crea /etc/efftrack.env con le variabili (vedi .env.example).
#      Variabili: EFFORT_TRACKING_SECRET_KEY, EFFORT_TRACKING_DB_URL,
#      UVICORN_HOST, UVICORN_PORT, EFFORT_TRACKING_LOG_LEVEL.
#      Nota: in produzione NON si usa il file .env locale; le variabili
#      arrivano esclusivamente da questo EnvironmentFile.
#   5. Ricarica systemd, abilita e avvia:
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now efftrack.service
#   6. Verifica:
#      sudo systemctl status efftrack.service
#      curl http://127.0.0.1:8000/health
# I log dell'app escono su journald (journalctl -u efftrack -f).
# =============================================================================

[Unit]
Description=Effort Tracking web server
After=network.target

[Service]
Type=simple
User=efftrack
Group=efftrack
WorkingDirectory=/opt/efftrack
EnvironmentFile=/etc/efftrack.env

# Avvio con il venv del progetto. Adatta il path se installi altrove.
# Host e porta NON sono hardcodati: uvicorn li legge dalle variabili native
# UVICORN_HOST / UVICORN_PORT definite nell'EnvironmentFile (/etc/efftrack.env),
# con default interni 127.0.0.1:8000. NON usare --host/--port qui e NON
# avvolgere in /bin/bash -c: il wrapper rompe il mount namespace di systemd
# (errore 226/NAMESPACE) sotto l'hardening ProtectSystem/ProtectHome.
ExecStart=/opt/efftrack/.venv/bin/uvicorn app.main:app --workers 1

Restart=always
RestartSec=3

# Hardening di base (rivisto in Fase 12).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# NB: questa directory DEVE esistere prima dell'avvio del servizio, altrimenti
# systemd fallisce con 226/NAMESPACE. La crea deploy.sh (--install) e le
# istruzioni manuali del README. L'app la usa per SQLite e export temporanei.
ReadWritePaths=/opt/efftrack/data

[Install]
WantedBy=multi-user.target