# =============================================================================
# Effort Tracking — variabili d'ambiente di esempio
# =============================================================================
# Copia questo file in `.env` e personalizza i valori per il tuo ambiente.
# Il file `.env` reale NON deve mai essere committato.
# =============================================================================

# Chiave segreta usata in futuro per firmare JWT/sessioni (auth in Fase 10).
# In produzione genera un valore casuale robusto, es.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EFFORT_TRACKING_SECRET_KEY=cambia-questa-chiave-prima-di-attivare-l-auth

# URL del database. Default: SQLite locale in data/efftrack.db.
# Esempio Postgres futuro:
#   EFFORT_TRACKING_DB_URL=postgresql://efftrack:PASSWORD@localhost:5432/efftrack
EFFORT_TRACKING_DB_URL=sqlite:///./data/efftrack.db

# Host e porta del web server, letti da uvicorn tramite le variabili native
# UVICORN_HOST / UVICORN_PORT (vedi systemd/efftrack.service).
# In produzione consigliato 127.0.0.1 (mettendo un reverse proxy davanti,
# es. nginx o Caddy); in sviluppo 0.0.0.0 per l'accesso da rete locale/WSL/VM.
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Livello di log applicativo. Valori: DEBUG, INFO, WARNING, ERROR.
# In produzione consigliato INFO; DEBUG solo per troubleshooting.
EFFORT_TRACKING_LOG_LEVEL=INFO

# Attivazione autenticazione (Fase 10). true = login obbligatorio,
# false = web server pubblico (utile in sviluppo/test).
EFFORT_TRACKING_AUTH_ENABLED=true

# Modalità demo: true → seed dati di esempio (gruppi, utenti, record di test).
# In produzione resta false (DB pulito, solo admin). L'opzione --demo di
# deploy.sh imposta questa variabile a true per ambienti di demo/test.
EFFORT_TRACKING_DEMO_MODE=false

# Credenziali del primo utente amministratore (creato al bootstrap se la
# tabella users è vuota). In produzione vanno sovrascritte con valori forti.
# NOTA (S11): la password qui impostata è TEMPORANEA. Viene letta SOLO al
# primo seed (tabella users vuota), poi hashata nel DB e mai più toccata.
# Al primo login l'admin è obbligato a cambiarla prima di poter navigare.
EFFORT_TRACKING_ADMIN_USERNAME=admin
EFFORT_TRACKING_ADMIN_PASSWORD=admin

# Suggestion 8: giorni minimi di disabilitazione prima che un utente possa
# essere eliminato definitivamente (insieme ai suoi record).
EFFORT_TRACKING_USER_DELETE_GRACE_DAYS=30

# Hardening Fase 13d: sicurezza del cookie di sessione.
# SameSite: "lax" blocca i CSRF cross-site (default Starlette).
# Secure: "true" richiede HTTPS (il browser scarta il cookie di sessione su
# HTTP). Su pre-prod/sviluppo senza TLS impostare false; in produzione dietro
# reverse proxy con TLS (es. NetScaler) impostare true.
EFFORT_TRACKING_SESSION_SAMESITE=lax
EFFORT_TRACKING_SESSION_SECURE=false
# Issue N (Fase 14 v1.0.1): durata massima della sessione in secondi.
# Default 30 minuti: se l'utente chiude il browser senza logout, la sessione
# scade e al prossimo accesso viene richiesto il login.
EFFORT_TRACKING_SESSION_MAX_AGE_SECONDS=1800

# Issue L (Fase 14): limite massimo del body delle richieste in byte.
# Default 1 MiB. Aumentare solo se si prevedono payload molto grandi.
EFFORT_TRACKING_MAX_BODY_BYTES=1048576
